# ─────────────────────────────────────────────────────────────────────────────
# Casa Monarca — Variables de entorno
# Copia este archivo a .env y completa los valores antes de arrancar.
# NUNCA subas .env al repositorio. Está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_SEGURA_50_CHARS

FLASK_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── JWT (separado del SECRET_KEY de Django) ───────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REEMPLAZAR_CON_JWT_SECRET_32_CHARS
JWT_ACCESS_TOKEN_EXPIRES=28800

# ── Cifrado de datos sensibles en BD ─────────────────────────────────────────
# PBKDF2-HMAC-SHA256 con 600,000 iteraciones.
# Genera password con: python -c "import secrets; print(secrets.token_hex(32))"
# Genera salt con:     python -c "import secrets; print(secrets.token_hex(16))"
# ⚠️  Si cambias estos valores, TODOS los datos cifrados dejan de ser accesibles.
DB_ENCRYPTION_MASTER_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO_MINIMO_32_CHARS
DB_ENCRYPTION_SALT=REEMPLAZAR_CON_SALT_HEX_16_BYTES

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite (desarrollo):
DATABASE_URL=sqlite:///casa_monarca.db

# MySQL (producción):
# MYSQL_DATABASE=casamonarca
# MYSQL_USER=casamonarca_user
# MYSQL_PASSWORD=REEMPLAZAR_CON_PASSWORD_BD
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# ── CA (Autoridad Certificadora) ──────────────────────────────────────────────
# Rutas a los archivos de la CA (generados por scripts/init_system.py)
CA_CERT_PATH=certs/ca_cert.pem
CA_KEY_PATH=certs/ca_key.enc.pem

# Contraseña de la clave privada de la CA.
# ⚠️  Esta contraseña es necesaria para EMITIR certificados (operación admin).
# No es necesaria para verificar ni para el funcionamiento normal del sistema.
# Se puede omitir en instancias solo de lectura.
# CA_MASTER_PASSWORD=REEMPLAZAR_CON_CA_PASSWORD

# ── ECC signing key (hash-chain legacy) ──────────────────────────────────────
# Ruta a la clave ECDSA del servidor para el hash-chain de trazabilidad.
# Se auto-genera en BASE_DIR/ecc_signing_key.pem si no se especifica.
# ECC_PRIVATE_KEY_PATH=

# ── Certificados ─────────────────────────────────────────────────────────────
CERT_ISSUER_NAME=Casa Monarca
CERT_EXPIRATION_DAYS=365
